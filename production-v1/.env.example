# Optional local environment file, loaded only when ENV_FILE points to it.
NODE_ENV=development
V1_PUBLIC_ORIGIN=http://localhost:3000
V1_TRUST_PROXY_HOPS=0
V1_STORE_DRIVER=atomic-file
V1_MEDIA_DRIVER=local
V1_LOCAL_MEDIA_PATH=media
V1_LLM_PROVIDER=deterministic
V1_ASR_PROVIDER=none
V1_TTS_PROVIDER=none

# Select exactly one LLM adapter. Values stay in an ignored env file or app settings.
# V1_HKBU_API_KEY=
# V1_HKBU_BASE_URL=
# V1_HKBU_MODEL=
# V1_HKBU_API_VERSION=
# V1_AZURE_OPENAI_KEY=
# V1_AZURE_OPENAI_ENDPOINT=
# V1_AZURE_OPENAI_DEPLOYMENT=
# V1_AZURE_OPENAI_API_VERSION=
# Allowed: standard sends temperature; reasoning omits it and reserves completion tokens.
# V1_AZURE_OPENAI_REQUEST_PROFILE=standard
# V1_MINIMAX_API_KEY=
# V1_MINIMAX_BASE_URL=
# V1_MINIMAX_ANTHROPIC_BASE_URL=
# V1_MINIMAX_LLM_MODEL=
# Production V1 Google AI uses ADC from the attached Cloud Run service account only.
# Never configure an API key, access token, service-account JSON, or credential-file path.
# V1_LLM_PROVIDER=vertex-ai
# V1_GOOGLE_CLOUD_PROJECT=motion-expert-hk-ltd-webpage
# V1_VERTEX_LOCATION=global
# V1_VERTEX_MODEL=gemini-2.5-flash
# Rotate this non-secret label whenever the selected LLM credential changes.
# V1_LLM_CREDENTIAL_VERSION=
# V1_LLM_PROVIDER_TIMEOUT_MS=12000

# Voice is opt-in and private. Production V1 selects Google STT V2 and Google TTS.
# Never commit provider credentials or non-sensitive ASR smoke fixtures.
# V1_ASR_PROVIDER=google-stt-v2
# V1_TTS_PROVIDER=google-tts
# V1_GOOGLE_STT_LOCATION=asia-southeast1
# V1_GOOGLE_STT_MODEL=chirp_2
# V1_GOOGLE_STT_RECOGNIZER=_
# V1_GOOGLE_TTS_LOCATION=asia-southeast1
# One release-selected voice per locale; there is no runtime fallback.
# V1_GOOGLE_TTS_VOICE_EN=en-US-Chirp3-HD-Achernar
# V1_GOOGLE_TTS_VOICE_YUE=yue-HK-Chirp3-HD-Achernar
# V1_GOOGLE_TTS_VOICE_CMN=cmn-CN-Chirp3-HD-Achernar
# Rotate this non-secret label when the attached runtime service-account authority changes.
# V1_GOOGLE_CREDENTIAL_VERSION=
# Legacy-compatible local adapters remain available outside the GCP release boundary.
# V1_AZURE_SPEECH_KEY=
# V1_AZURE_SPEECH_REGION=
# V1_AZURE_SPEECH_CREDENTIAL_VERSION=
# V1_MINIMAX_TTS_MODEL=
# V1_MINIMAX_TTS_VOICE=
# V1_MINIMAX_CREDENTIAL_VERSION=
# V1_ASR_LIMIT_10M=10
# V1_ASR_LIMIT_DAY=60
# V1_TTS_LIMIT_10M=5
# V1_TTS_LIMIT_DAY=20
# V1_RELEASE_COMMIT_SHA=
# V1_ASR_SMOKE_EVIDENCE_FILE=
# V1_ASR_SMOKE_EVIDENCE_VERSION=
# V1_TTS_SMOKE_EVIDENCE_FILE=
# V1_TTS_SMOKE_EVIDENCE_VERSION=
# V1_IOS_VOICE_ACCEPTANCE_FILE=
# V1_IOS_VOICE_ACCEPTANCE_VERSION=

# Production requires non-example values for every setting below.
# V1_SESSION_SECRET=
# The stable origin is fixed to the selected shared host project. A release
# candidate uses the SHA-bound private tag form shown below until promotion.
# V1_PUBLIC_ORIGIN=https://hkbuddy-v1-api-582852715831.asia-east2.run.app
# V1_CANDIDATE_ORIGIN=https://candidate-<12-lowercase-hex>---hkbuddy-v1-api-582852715831.asia-east2.run.app
# V1_RUNTIME_SERVICE_ACCOUNT=hkbuddy-v1-runtime@motion-expert-hk-ltd-webpage.iam.gserviceaccount.com
# V1_STORE_DRIVER=postgres
# V1_DATABASE_URL=postgres://user:password@private-postgres.example/database?sslmode=require
# V1_POSTGRES_RESOURCE_ID=//sqladmin.googleapis.com/projects/motion-expert-hk-ltd-webpage/instances/hkbuddy-v1-pg/databases/hkbuddy_v1
# Production storage is exact and ADC-only; Azure aliases are ignored in production.
# V1_MEDIA_DRIVER=gcs
# V1_GCS_BUCKET=hkbuddy-v1-582852715831-media
# V1_GCS_RESOURCE_ID=//storage.googleapis.com/projects/_/buckets/hkbuddy-v1-582852715831-media
# The guarded provider smoke writes this immutable artifact; normal startup requires both values.
# V1_LLM_SMOKE_EVIDENCE_FILE=
# V1_LLM_SMOKE_EVIDENCE_VERSION=
# V1_LEGACY_RESOURCE_INVENTORY_FILE=
# V1_LEGACY_RESOURCE_INVENTORY_VERSION=
# V1_LEGACY_RESOURCE_INVENTORY_APPROVED=true
# V1_DEPENDENCY_ACCEPTANCE_EVIDENCE_FILE=
# V1_DEPENDENCY_ACCEPTANCE_EVIDENCE_VERSION=
# V1_INSTANCE_POLICY=single
# Combined iOS App Store notice. Leave unset to keep existing campus-only tests
# and the current Cloud Run pin working without first-use gating.
# V1_PRIVACY_NOTICE_VERSION=2026-09-10-ios-combined
# V1_REQUIRE_AI_CONSENT=true
# V1_PRIVACY_NOTICE_APPROVED=true
# V1_IOS_TESTFLIGHT_VOICE_ACCEPTANCE_FILE=
# V1_IOS_TESTFLIGHT_VOICE_ACCEPTANCE_VERSION=
# V1_RETENTION_WORKER_ENABLED=true
# Bounded production dependency and startup waits (milliseconds).
# V1_DEPENDENCY_INIT_TIMEOUT_MS=10000
# V1_READINESS_CHECK_TIMEOUT_MS=3000
# V1_READINESS_WATCHDOG_INTERVAL_MS=30000
# V1_STARTUP_STEP_TIMEOUT_MS=15000
# V1_POSTGRES_CONNECTION_TIMEOUT_MS=5000
# V1_POSTGRES_QUERY_TIMEOUT_MS=10000
# V1_POSTGRES_STATEMENT_TIMEOUT_MS=10000
